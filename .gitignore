# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.js

# testing
/coverage
coverage

# next.js
/.next/
/out/
apps/**/.next/

# production
/build
dist
**/dist

# misc
.DS_Store
*.pem
.turbo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit any of them; .env.example is the only exception
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# lockfiles — bun.lock is committed on purpose (reproducible installs).
# This project uses bun; don't let npm re-introduce a second lockfile.
package-lock.json

# editor
Session.vim

# temp/dev assets
public/temp/

# claude — machine-local settings
.claude/settings.local.json

# local-only notes: planning docs, decision logs. This repo is public.
.private/

# third-party agent skills and their lock — local only, don't redistribute
.agents/
.claude/skills/
skills-lock.json

# Fontshare fonts (ITF Free Font License): self-hosted on the site, but the
# license forbids sharing the files through a public repository. They come
# from the private fonts repo at build time (scripts/fetch-licensed-fonts.ts).
src/app/styles/local-fonts/licensed/
